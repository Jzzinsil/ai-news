<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jzzinsil.ainews-channelsync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>"$HOME/Library/ainews-sync/run.sh"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>35</integer></dict>
  <!-- 로그인 시에도 1회 실행: 06:35에 Mac이 꺼져 있던 날을 커버 (스크립트가 멱등이라 중복 실행 무해) -->
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/jinsillee/Library/Logs/ainews-channelsync.log</string>
  <key>StandardErrorPath</key><string>/Users/jinsillee/Library/Logs/ainews-channelsync.log</string>
</dict>
</plist>
